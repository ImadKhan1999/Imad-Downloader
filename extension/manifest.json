{
  "manifest_version": 3,
  "name": "Hyper Downloader Integration",
  "short_name": "Hyper DL",
  "version": "1.5.0",
  "description": "Sends downloads, videos and links from your browser to Hyper Downloader for fast multi-connection downloading.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hyper Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "contextMenus", "storage", "cookies", "webRequest", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "110"
}
