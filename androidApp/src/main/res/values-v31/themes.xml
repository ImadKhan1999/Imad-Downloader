<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: animated startup icon (arrow drops into the tray, then the quantum dot). -->
    <style name="Theme.IDownloader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">1100</item>
        <item name="postSplashScreenTheme">@style/Theme.IDownloader</item>
    </style>
</resources>
